{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "exec", "next", "dev", "-p", "3002"],
      "port": 3002,
      "url": "http://localhost:3002"
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:api"],
      "port": 3001
    },
    {
      "name": "demo",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/demo/server.js"],
      "port": 3003
    }
  ]
}
