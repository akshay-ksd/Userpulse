// Userpulse — application state (system of record).
// Behavioral event data lives in ClickHouse, not here. See harness/architecture.md §4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      OrganizationMember[]
  invitationsSent  OrganizationInvitation[] @relation("invitations_sent")

  @@map("users")
}

// Authentication sessions for @nestjs/authentication's SessionStore.
// `id` is the SHA-256 hash of the session cookie token — never the token itself.
// No FK to users: the store's contract tests use throwaway user ids, and
// SessionAuth.validate() ends sessions whose user is gone anyway.
model Session {
  id           String   @id
  userId       String
  createdAt    DateTime @db.Timestamptz(6)
  expiresAt    DateTime @db.Timestamptz(6)
  lastActiveAt DateTime @db.Timestamptz(6)
  mfa          String?
  metadata     Json?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id
  userId    String
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          OrganizationMember[]
  invitations      OrganizationInvitation[]
  projects         Project[]
  retentionSetting DataRetentionSetting?

  @@map("organizations")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole @default(MEMBER)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime         @db.Timestamptz(6)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("invitations_sent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([tokenHash])
  @@map("organization_invitations")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys              ProjectApiKey[]
  features             Feature[]
  featureEventMappings FeatureEventMapping[]
  funnels              Funnel[]
  analysisRuns         AnalysisRun[]
  recommendations      Recommendation[]
  analysisSchedule     AnalysisSchedule?

  @@index([organizationId])
  @@map("projects")
}

model ProjectApiKey {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  createdBy   String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  revokedBy   String?
  lastUsedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_api_keys")
}

enum FeatureStatus {
  ACTIVE
  ARCHIVED
}

model Feature {
  id          String        @id @default(uuid())
  projectId   String
  name        String
  description String?
  status      FeatureStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mappings        FeatureEventMapping[]
  recommendations Recommendation[]

  @@index([projectId])
  @@map("features")
}

model FeatureEventMapping {
  id        String   @id @default(uuid())
  featureId String
  projectId String
  eventName String
  createdAt DateTime @default(now())

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, eventName])
  @@index([featureId])
  @@map("feature_event_mappings")
}

model Event {
  id               String    @id @default(uuid())
  organizationId   String
  projectId        String
  eventId          String
  eventName        String
  anonymousId      String?
  userId           String?
  properties       Json?
  sdkVersion       String?
  eventTimestamp   DateTime  @db.Timestamptz(6)
  ingestedAt       DateTime  @default(now()) @db.Timestamptz(6)
  processingStatus String    @default("PENDING")
  retryCount       Int       @default(0)
  processedAt      DateTime? @db.Timestamptz(6)
  processingError  String?
  validationStatus String    @default("VALID")
  validationError  String?

  @@index([projectId, ingestedAt])
  @@index([processingStatus, ingestedAt])
  @@index([processingStatus, retryCount])
  @@unique([projectId, eventId])
  @@index([projectId, validationStatus])
  @@index([projectId, eventTimestamp])
  @@map("events")
}

model Funnel {
  id        String   @id @default(uuid())
  projectId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps   FunnelStep[]

  @@index([projectId])
  @@map("funnels")
}

model AnalysisRun {
  id              String    @id @default(uuid())
  projectId       String
  organizationId  String
  requestedById   String
  status          String    @default("QUEUED")
  periodStart     DateTime  @db.Timestamptz(6)
  periodEnd       DateTime  @db.Timestamptz(6)
  eventCount      Int?
  statusMessage   String?
  startedAt       DateTime? @db.Timestamptz(6)
  completedAt     DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@map("analysis_runs")
}

model Recommendation {
  id                String    @id @default(uuid())
  analysisRunId     String
  projectId         String
  organizationId    String
  title             String
  summary           String
  suggestedAction   String
  category          String
  affectedFeatureId String?
  affectedArea      String?
  evidence          Json
  confidence        Float?
  impact            Float?
  reach             Float?
  priorityScore     Float?
  periodStart       DateTime  @db.Timestamptz(6)
  periodEnd         DateTime  @db.Timestamptz(6)
  status            String    @default("PUBLISHED")
  supersededById    String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt

  analysisRun  AnalysisRun     @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature      Feature?        @relation(fields: [affectedFeatureId], references: [id], onDelete: SetNull)
  supersededBy Recommendation? @relation("RecommendationSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Recommendation[] @relation("RecommendationSupersedes")
  statusHistory RecommendationStatusHistory[]

  @@index([projectId, status])
  @@index([analysisRunId])
  @@index([projectId, createdAt])
  @@index([projectId, priorityScore(sort: Desc)])
  @@map("recommendations")
}

model RecommendationStatusHistory {
  id               String   @id @default(uuid())
  recommendationId String
  fromStatus       String
  toStatus         String
  changedBy        String
  reason           String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId, createdAt])
  @@map("recommendation_status_history")
}

model AnalysisSchedule {
  id             String    @id @default(uuid())
  projectId      String    @unique
  organizationId String
  intervalHours  Int
  enabled        Boolean   @default(true)
  lastRunAt      DateTime? @db.Timestamptz(6)
  nextRunAt      DateTime  @db.Timestamptz(6)
  createdBy      String
  updatedBy      String
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@map("analysis_schedules")
}

model DataRetentionSetting {
  id                 String       @id @default(uuid())
  organizationId     String       @unique
  eventRetentionDays Int          @default(90)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("data_retention_settings")
}

model DataDeletionRequest {
  id              String    @id @default(uuid())
  projectId       String
  organizationId  String
  requestedBy     String
  status          String    @default("PENDING")
  scope           Json
  eventsDeleted   Int       @default(0)
  recordsDeleted  Int       @default(0)
  error           String?
  confirmedAt     DateTime? @db.Timestamptz(6)
  startedAt       DateTime? @db.Timestamptz(6)
  completedAt     DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt

  @@index([projectId, status])
  @@index([status, createdAt])
  @@map("data_deletion_requests")
}

model FunnelStep {
  id        String   @id @default(uuid())
  funnelId  String
  stepOrder Int
  eventName String
  createdAt DateTime @default(now())

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, stepOrder])
  @@index([funnelId])
  @@map("funnel_steps")
}
